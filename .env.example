# ==========================================================
# Contoh pengaturan lingkungan Gereja Alfa Omega
# Salin menjadi .env (folder aplikasi) atau isi di hPanel > Node.js > Environment variables.
# Variabel bertanda [CMS] juga bisa diubah developer dari /admin > Sistem & Cadangan;
# perubahan itu disimpan otomatis ke DATA_DIR/.env setiap kali disimpan.
# Berkas ini dibuat dari server/konfigurasi.js: jalankan `npm run env:contoh` setelah menambah variabel.
# ==========================================================

# --- Website ---
# Alamat utama website tanpa garis miring di akhir. Dipakai untuk sitemap, tautan kanonik, gambar saat link dibagikan, dan tautan di email. Kosong = memakai alamat yang sedang diakses pengunjung. [CMS]
# Contoh: SITE_URL=https://testingwebsite.click
SITE_URL=

# --- Penyimpanan ---
# Folder data CMS (isi, pengguna, foto unggahan, log, versi). Taruh di luar folder aplikasi agar tidak terhapus saat deploy ulang. Bawaan: ~/alfaomega-data.
# Contoh: DATA_DIR=/home/u123456789/alfaomega-data
DATA_DIR=

# --- Keamanan ---
# Kode untuk membuat akun developer pertama di /admin. Bila kosong, kode dibuat otomatis di DATA_DIR/kode-setup.txt.
# Contoh: CMS_KODE_SETUP=ganti-dengan-kode-pilihan-anda
CMS_KODE_SETUP=
# Kunci penanda tangan sesi masuk. Bila kosong, dibuat otomatis di DATA_DIR/rahasia-sesi.key. Mengubahnya membuat semua pengguna keluar.
# Contoh: SESSION_SECRET=teks-acak-panjang-minimal-32-karakter
SESSION_SECRET=

# --- Email ---
# Server SMTP untuk mengirim email (OTP lupa kata sandi, pemberitahuan akun). Hostinger: smtp.hostinger.com. Gmail: smtp.gmail.com. [CMS]
# Contoh: SMTP_HOST=smtp.hostinger.com
SMTP_HOST=
# Port SMTP. 465 (SSL, disarankan) atau 587 (STARTTLS). [CMS]
# Contoh: SMTP_PORT=465
SMTP_PORT=
# Nama pengguna SMTP, biasanya alamat email lengkap. [CMS]
# Contoh: SMTP_USER=noreply@testingwebsite.click
SMTP_USER=
# Kata sandi akun email (Gmail: App Password, bukan sandi biasa). [CMS]
# Contoh: SMTP_PASS=kata-sandi-email
SMTP_PASS=
# Pengirim yang tampil di email. Bawaan: SMTP_USER. [CMS]
# Contoh: MAIL_FROM='Gereja Alfa Omega <noreply@testingwebsite.click>'
MAIL_FROM=
# Alamat balasan (Reply-To), opsional. [CMS]
# Contoh: MAIL_BALAS=sekretariat@testingwebsite.click
MAIL_BALAS=

# --- Server ---
# Port server. Biasanya diatur otomatis oleh Hostinger; bawaan 3000.
# Contoh: PORT=3000
PORT=
